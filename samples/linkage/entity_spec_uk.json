{
  "unique_id_column": "unique_id",
  "comparisons": [
    {"column": "name", "kind": "jaro_winkler", "thresholds": [0.96, 0.88]},
    {"column": "address", "kind": "jaccard", "thresholds": [0.92, 0.82]},
    {"column": "registry_code", "kind": "levenshtein", "thresholds": [1, 3]},
    {"column": "aliases", "kind": "array_intersect", "thresholds": [2, 1]},
    {"column": "city", "kind": "exact"},
    {"column": "effective_date", "kind": "date_difference", "thresholds": [30, 365],
     "date_metric": "day", "date_format": "%Y-%m-%d"}
  ],
  "blocking_rules": [
    {"expressions": ["city"]},
    {"expressions": ["substring(registry_code, 1, 6)"]}
  ],
  "training_rules": [
    {"expressions": ["city"]},
    {"expressions": ["substring(registry_code, 1, 6)"]}
  ],
  "retain_columns": ["source_doc"],
  "match_threshold": 0.9,
  "max_pairs": 200000,
  "seed": 7,
  "random_match_probability": 0.02
}
