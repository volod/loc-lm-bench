{
  "$id": "urn:llb:artifact-contract:llb.miss-case:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One classified miss (`misses.jsonl`): a pointer a human follows back into the run.",
  "properties": {
    "answer_preview": {
      "title": "Answer Preview",
      "type": "string"
    },
    "first_hit_rank": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "First Hit Rank"
    },
    "item_id": {
      "minLength": 1,
      "title": "Item Id",
      "type": "string"
    },
    "judge_score": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Judge Score"
    },
    "miss_class": {
      "minLength": 1,
      "title": "Miss Class",
      "type": "string"
    },
    "objective_score": {
      "title": "Objective Score",
      "type": "number"
    },
    "question": {
      "title": "Question",
      "type": "string"
    },
    "question_type": {
      "title": "Question Type",
      "type": "string"
    },
    "retrieval_hit": {
      "title": "Retrieval Hit",
      "type": "boolean"
    },
    "retrieved_docs": {
      "items": {
        "type": "string"
      },
      "title": "Retrieved Docs",
      "type": "array"
    },
    "schema_id": {
      "const": "llb.miss-case",
      "default": "llb.miss-case",
      "title": "Schema Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_doc_id": {
      "title": "Source Doc Id",
      "type": "string"
    },
    "status": {
      "title": "Status",
      "type": "string"
    },
    "topic": {
      "title": "Topic",
      "type": "string"
    }
  },
  "required": [
    "item_id",
    "miss_class",
    "status",
    "objective_score",
    "retrieval_hit",
    "question",
    "source_doc_id",
    "topic",
    "question_type",
    "answer_preview"
  ],
  "title": "MissCaseRow",
  "type": "object"
}
