{
  "$defs": {
    "ChunkingRecommendation": {
      "additionalProperties": false,
      "description": "The chunking the recommended store was built with.",
      "properties": {
        "overlap": {
          "title": "Overlap",
          "type": "integer"
        },
        "size": {
          "title": "Size",
          "type": "integer"
        },
        "strategy": {
          "title": "Strategy",
          "type": "string"
        }
      },
      "required": [
        "strategy",
        "size",
        "overlap"
      ],
      "title": "ChunkingRecommendation",
      "type": "object"
    },
    "PromptSystemRecommendation": {
      "additionalProperties": false,
      "description": "The prompt-system package the recommendation was measured with.\n\n`knowledge_tree` is the selected candidate's own tree provenance -- its depth, budget, and\ndigest -- so its keys belong to the prompt-system packager that produced them rather than to\nthis record, which only says which package the measurement used.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "knowledge_tree": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Knowledge Tree"
        },
        "package": {
          "title": "Package",
          "type": "string"
        }
      },
      "required": [
        "id",
        "package"
      ],
      "title": "PromptSystemRecommendation",
      "type": "object"
    },
    "RetrievalRecommendation": {
      "additionalProperties": false,
      "description": "The retrieval lane the recommendation was measured on.",
      "properties": {
        "backend": {
          "title": "Backend",
          "type": "string"
        },
        "context_budget": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Context Budget"
        },
        "fusion_candidates": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fusion Candidates"
        },
        "fusion_weight": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fusion Weight"
        },
        "mode": {
          "title": "Mode",
          "type": "string"
        },
        "query_prep": {
          "items": {
            "type": "string"
          },
          "title": "Query Prep",
          "type": "array"
        },
        "rerank_candidates": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rerank Candidates"
        },
        "reranker": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reranker"
        },
        "top_k": {
          "title": "Top K",
          "type": "integer"
        }
      },
      "required": [
        "backend",
        "mode",
        "top_k"
      ],
      "title": "RetrievalRecommendation",
      "type": "object"
    },
    "ServingRecommendation": {
      "additionalProperties": false,
      "description": "How the recommended model is to be served.",
      "properties": {
        "cpu_offload_gb": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cpu Offload Gb"
        },
        "dtype": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dtype"
        },
        "gpu_memory_utilization": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gpu Memory Utilization"
        },
        "kv_offloading_size_gb": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kv Offloading Size Gb"
        },
        "max_model_len": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Model Len"
        },
        "n_gpu_layers": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "N Gpu Layers"
        },
        "quantization": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quantization"
        }
      },
      "title": "ServingRecommendation",
      "type": "object"
    }
  },
  "$id": "urn:llb:artifact-contract:llb.rag-recommendation:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`rag_recommendation.yaml`: the configuration auto-RAG selected, and what backs it.\n\n`evidence` holds each stage's own reading verbatim -- the verification accept rate, the\nretrieval validation, the joint search scoreboard, and the final split -- so the operator\ncopying the configuration above it can see, in the same file, what the numbers were.",
  "properties": {
    "backend": {
      "title": "Backend",
      "type": "string"
    },
    "chunking": {
      "$ref": "#/$defs/ChunkingRecommendation"
    },
    "evidence": {
      "additionalProperties": true,
      "title": "Evidence",
      "type": "object"
    },
    "model": {
      "title": "Model",
      "type": "string"
    },
    "model_name": {
      "title": "Model Name",
      "type": "string"
    },
    "prompt_system": {
      "$ref": "#/$defs/PromptSystemRecommendation"
    },
    "retrieval": {
      "$ref": "#/$defs/RetrievalRecommendation"
    },
    "schema_id": {
      "const": "llb.rag-recommendation",
      "default": "llb.rag-recommendation",
      "title": "Schema Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "serving": {
      "$ref": "#/$defs/ServingRecommendation"
    }
  },
  "required": [
    "model",
    "model_name",
    "backend",
    "serving",
    "chunking",
    "retrieval",
    "prompt_system",
    "evidence"
  ],
  "title": "RagRecommendationDocument",
  "type": "object"
}
