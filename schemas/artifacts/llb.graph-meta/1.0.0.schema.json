{
  "$id": "urn:llb:artifact-contract:llb.graph-meta:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`graph_meta.json`: the shape of one graph generation and the corpus it was built from.",
  "properties": {
    "backend": {
      "title": "Backend",
      "type": "string"
    },
    "doc_fingerprints": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Doc Fingerprints",
      "type": "object"
    },
    "khop_depth": {
      "minimum": 0,
      "title": "Khop Depth",
      "type": "integer"
    },
    "n_communities": {
      "minimum": 0,
      "title": "N Communities",
      "type": "integer"
    },
    "n_documents": {
      "minimum": 0,
      "title": "N Documents",
      "type": "integer"
    },
    "n_edges": {
      "minimum": 0,
      "title": "N Edges",
      "type": "integer"
    },
    "n_nodes": {
      "minimum": 0,
      "title": "N Nodes",
      "type": "integer"
    },
    "refreshed_from": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Refreshed From"
    },
    "schema_id": {
      "const": "llb.graph-meta",
      "title": "Schema Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "backend",
    "n_nodes",
    "n_edges",
    "n_communities",
    "n_documents",
    "khop_depth"
  ],
  "title": "GraphMetaDocument",
  "type": "object"
}
