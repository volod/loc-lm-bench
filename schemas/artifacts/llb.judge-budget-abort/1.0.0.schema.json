{
  "$id": "urn:llb:artifact-contract:llb.judge-budget-abort:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`scorer/abort.json`: the judge stopped on its declared spend or call budget.\n\n`resumable` is the load-bearing field: this is a bounded stop with the scorer's state intact,\nnot a failed run, and an operator who raises the budget continues from here.",
  "properties": {
    "calls": {
      "minimum": 0,
      "title": "Calls",
      "type": "integer"
    },
    "cost_usd": {
      "minimum": 0.0,
      "title": "Cost Usd",
      "type": "number"
    },
    "reason": {
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "resumable": {
      "title": "Resumable",
      "type": "boolean"
    },
    "schema_id": {
      "const": "llb.judge-budget-abort",
      "default": "llb.judge-budget-abort",
      "title": "Schema Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "const": "aborted",
      "default": "aborted",
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "resumable",
    "reason",
    "calls",
    "cost_usd"
  ],
  "title": "JudgeBudgetAbort",
  "type": "object"
}
