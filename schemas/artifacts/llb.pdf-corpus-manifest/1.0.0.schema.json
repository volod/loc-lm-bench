{
  "$defs": {
    "PdfItemRecord": {
      "additionalProperties": false,
      "description": "One PDF conversion outcome, mirroring `llb.prep.pdf.model.PdfCorpusItem`.",
      "properties": {
        "attempts": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Attempts",
          "type": "array"
        },
        "citation_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Citation Path"
        },
        "diagnostics": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Diagnostics"
        },
        "doc_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Doc Id"
        },
        "embedded_text_chars": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Embedded Text Chars"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "image_only_pages": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image Only Pages"
        },
        "n_chars": {
          "minimum": 0,
          "title": "N Chars",
          "type": "integer"
        },
        "page_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Count"
        },
        "parser": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parser"
        },
        "quality": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quality"
        },
        "repeat_blocks": {
          "default": "",
          "minLength": 0,
          "title": "Repeat Blocks",
          "type": "string"
        },
        "reused": {
          "default": false,
          "title": "Reused",
          "type": "boolean"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "source_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Sha256"
        },
        "status": {
          "minLength": 1,
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "source",
        "doc_id",
        "n_chars",
        "status"
      ],
      "title": "PdfItemRecord",
      "type": "object"
    }
  },
  "$id": "urn:llb:artifact-contract:llb.pdf-corpus-manifest:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`pdf_corpus_manifest.json` and `pdf_corpus_quality.json`; `kind` separates the two.",
  "properties": {
    "corpus_root": {
      "minLength": 1,
      "title": "Corpus Root",
      "type": "string"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/PdfItemRecord"
      },
      "title": "Items",
      "type": "array"
    },
    "kind": {
      "enum": [
        "pdf-corpus",
        "pdf-corpus-quality"
      ],
      "title": "Kind",
      "type": "string"
    },
    "n_docs": {
      "minimum": 0,
      "title": "N Docs",
      "type": "integer"
    },
    "n_pdfs": {
      "minimum": 0,
      "title": "N Pdfs",
      "type": "integer"
    },
    "n_skipped": {
      "minimum": 0,
      "title": "N Skipped",
      "type": "integer"
    },
    "pdf_root": {
      "minLength": 1,
      "title": "Pdf Root",
      "type": "string"
    },
    "schema_id": {
      "const": "llb.pdf-corpus-manifest",
      "title": "Schema Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "kind",
    "pdf_root",
    "corpus_root",
    "n_pdfs",
    "n_docs",
    "n_skipped"
  ],
  "title": "PdfCorpusManifest",
  "type": "object"
}
