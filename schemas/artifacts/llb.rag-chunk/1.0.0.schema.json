{
  "$id": "urn:llb:artifact-contract:llb.rag-chunk:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One indexed unit or one parent: `chunks.jsonl` and `parents.jsonl` share this contract.\n\nThe two files hold the same record at different granularities -- a parent IS a chunk that was\nnot indexed -- so one family binds both, and a store's manifest distinguishes them by member\nrather than by shape. The retrieval-time fields (`retrieval_score`, `rank`, `rerank_score`,\n`pre_rerank_rank`, `matched_child_id`) belong to a returned hit and are absent on disk; they\nare declared because the same record is what a lane hands to scoring.",
  "properties": {
    "char_end": {
      "minimum": 0,
      "title": "Char End",
      "type": "integer"
    },
    "char_start": {
      "minimum": 0,
      "title": "Char Start",
      "type": "integer"
    },
    "chunk_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Chunk Id"
    },
    "doc_id": {
      "title": "Doc Id",
      "type": "string"
    },
    "matched_child_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Matched Child Id"
    },
    "metadata": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Metadata"
    },
    "overlap": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Overlap"
    },
    "parent_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Id"
    },
    "pre_rerank_rank": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pre Rerank Rank"
    },
    "rank": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rank"
    },
    "rerank_score": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rerank Score"
    },
    "retrieval_score": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Retrieval Score"
    },
    "schema_id": {
      "const": "llb.rag-chunk",
      "title": "Schema Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "size": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Size"
    },
    "strategy": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Strategy"
    },
    "text": {
      "title": "Text",
      "type": "string"
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "doc_id",
    "char_start",
    "char_end",
    "text"
  ],
  "title": "ChunkRow",
  "type": "object"
}
