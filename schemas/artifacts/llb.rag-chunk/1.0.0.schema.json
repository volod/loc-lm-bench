{
  "$id": "urn:llb:artifact-contract:llb.rag-chunk:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One indexed unit: an offset-exact source span plus how it was chunked.\n\nA `parents.jsonl` row is the same record without `parent_id`; a `parent_child` child carries\nthe parent it belongs to. Query-time fields (`retrieval_score`, `rank`, `rerank_score`) are\nnever persisted -- they describe one answer, not the store.",
  "properties": {
    "char_end": {
      "minimum": 0,
      "title": "Char End",
      "type": "integer"
    },
    "char_start": {
      "minimum": 0,
      "title": "Char Start",
      "type": "integer"
    },
    "chunk_id": {
      "minLength": 1,
      "title": "Chunk Id",
      "type": "string"
    },
    "doc_id": {
      "minLength": 1,
      "title": "Doc Id",
      "type": "string"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "overlap": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Overlap"
    },
    "parent_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Id"
    },
    "schema_id": {
      "const": "llb.rag-chunk",
      "title": "Schema Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "size": {
      "minimum": 0,
      "title": "Size",
      "type": "integer"
    },
    "strategy": {
      "minLength": 1,
      "title": "Strategy",
      "type": "string"
    },
    "text": {
      "title": "Text",
      "type": "string"
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "doc_id",
    "chunk_id",
    "char_start",
    "char_end",
    "text",
    "strategy",
    "size"
  ],
  "title": "RagChunkRecord",
  "type": "object"
}
