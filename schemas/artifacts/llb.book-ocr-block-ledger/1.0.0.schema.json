{
  "$defs": {
    "Block": {
      "additionalProperties": false,
      "description": "One recovered region: its kind, where it sits, and every raw reading of it.",
      "properties": {
        "block_id": {
          "minLength": 1,
          "title": "Block Id",
          "type": "string"
        },
        "cell_disputes": {
          "items": {
            "$ref": "#/$defs/CellDispute"
          },
          "title": "Cell Disputes",
          "type": "array"
        },
        "kind": {
          "enum": [
            "body",
            "heading",
            "formula",
            "table",
            "figure",
            "caption",
            "footnote",
            "running-header",
            "page-number",
            "ornament",
            "neighbour-page-bleed",
            "unknown"
          ],
          "title": "Kind",
          "type": "string"
        },
        "ordinal": {
          "minimum": 0,
          "title": "Ordinal",
          "type": "integer"
        },
        "paragraph": {
          "default": false,
          "title": "Paragraph",
          "type": "boolean"
        },
        "pdf_page": {
          "minimum": 1,
          "title": "Pdf Page",
          "type": "integer"
        },
        "reading_order": {
          "minimum": 0,
          "title": "Reading Order",
          "type": "integer"
        },
        "readings": {
          "items": {
            "$ref": "#/$defs/RawReading"
          },
          "minItems": 1,
          "title": "Readings",
          "type": "array"
        },
        "region": {
          "$ref": "#/$defs/Region"
        },
        "uncertainty": {
          "items": {
            "$ref": "#/$defs/UncertaintySpan"
          },
          "title": "Uncertainty",
          "type": "array"
        }
      },
      "required": [
        "block_id",
        "pdf_page",
        "ordinal",
        "kind",
        "region",
        "reading_order",
        "readings"
      ],
      "title": "Block",
      "type": "object"
    },
    "CellDispute": {
      "additionalProperties": false,
      "description": "A cell two engines read differently, after the dangerous-substitution check.\n\n``classes`` is the ledger's coarse check. ``substitutions`` names the dangerous-substitution\nclasses that fired, and ``sources`` keeps each engine's cell text.",
      "properties": {
        "classes": {
          "items": {
            "enum": [
              "digit",
              "sign",
              "decimal",
              "symbol"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Classes",
          "type": "array"
        },
        "column": {
          "minimum": 0,
          "title": "Column",
          "type": "integer"
        },
        "row": {
          "minimum": 0,
          "title": "Row",
          "type": "integer"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/CellSource"
          },
          "minItems": 2,
          "title": "Sources",
          "type": "array"
        },
        "substitutions": {
          "items": {
            "type": "string"
          },
          "title": "Substitutions",
          "type": "array"
        }
      },
      "required": [
        "row",
        "column",
        "classes",
        "sources"
      ],
      "title": "CellDispute",
      "type": "object"
    },
    "CellSource": {
      "additionalProperties": false,
      "description": "One engine's text for one disputed cell.",
      "properties": {
        "engine": {
          "minLength": 1,
          "title": "Engine",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "variant": {
          "minLength": 1,
          "title": "Variant",
          "type": "string"
        }
      },
      "required": [
        "engine",
        "variant",
        "text"
      ],
      "title": "CellSource",
      "type": "object"
    },
    "FormulaReading": {
      "additionalProperties": false,
      "description": "One engine's formula. ``display`` is false for inline math.\n\n``equation_number`` is the printed number, without the parentheses that merely delimited it.\n``number_side`` is where that number sits relative to the formula.",
      "properties": {
        "display": {
          "default": true,
          "title": "Display",
          "type": "boolean"
        },
        "equation_number": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Equation Number"
        },
        "latex": {
          "title": "Latex",
          "type": "string"
        },
        "number_side": {
          "anyOf": [
            {
              "enum": [
                "left",
                "right"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Number Side"
        }
      },
      "required": [
        "latex"
      ],
      "title": "FormulaReading",
      "type": "object"
    },
    "RawReading": {
      "additionalProperties": false,
      "description": "One engine's text for one image variant. Raw: nothing here has been chosen or corrected.",
      "properties": {
        "confidence": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "engine": {
          "minLength": 1,
          "title": "Engine",
          "type": "string"
        },
        "formula": {
          "anyOf": [
            {
              "$ref": "#/$defs/FormulaReading"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "table": {
          "anyOf": [
            {
              "$ref": "#/$defs/TableReading"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "variant": {
          "minLength": 1,
          "title": "Variant",
          "type": "string"
        }
      },
      "required": [
        "engine",
        "variant",
        "text"
      ],
      "title": "RawReading",
      "type": "object"
    },
    "Region": {
      "additionalProperties": false,
      "description": "An axis-aligned box on the rendered page image, origin at the top left, in pixels.",
      "properties": {
        "height": {
          "minimum": 1,
          "title": "Height",
          "type": "integer"
        },
        "width": {
          "minimum": 1,
          "title": "Width",
          "type": "integer"
        },
        "x0": {
          "minimum": 0,
          "title": "X0",
          "type": "number"
        },
        "x1": {
          "title": "X1",
          "type": "number"
        },
        "y0": {
          "minimum": 0,
          "title": "Y0",
          "type": "number"
        },
        "y1": {
          "title": "Y1",
          "type": "number"
        }
      },
      "required": [
        "x0",
        "y0",
        "x1",
        "y1",
        "width",
        "height"
      ],
      "title": "Region",
      "type": "object"
    },
    "TableCell": {
      "additionalProperties": false,
      "description": "One cell. An empty ``text`` is a cell the engine saw and left blank.",
      "properties": {
        "colspan": {
          "default": 1,
          "minimum": 1,
          "title": "Colspan",
          "type": "integer"
        },
        "rowspan": {
          "default": 1,
          "minimum": 1,
          "title": "Rowspan",
          "type": "integer"
        },
        "text": {
          "default": "",
          "title": "Text",
          "type": "string"
        }
      },
      "title": "TableCell",
      "type": "object"
    },
    "TableReading": {
      "additionalProperties": false,
      "description": "A table grid. ``faithful`` is false when an HTML table cannot hold the grid.",
      "properties": {
        "caption": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Caption"
        },
        "faithful": {
          "default": true,
          "title": "Faithful",
          "type": "boolean"
        },
        "header_rows": {
          "default": 1,
          "minimum": 0,
          "title": "Header Rows",
          "type": "integer"
        },
        "rows": {
          "items": {
            "items": {
              "$ref": "#/$defs/TableCell"
            },
            "type": "array"
          },
          "minItems": 1,
          "title": "Rows",
          "type": "array"
        }
      },
      "required": [
        "rows"
      ],
      "title": "TableReading",
      "type": "object"
    },
    "UncertaintySlice": {
      "additionalProperties": false,
      "description": "The characters one reading has across a disagreement, as offsets into that reading.",
      "properties": {
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "integer"
        },
        "engine": {
          "minLength": 1,
          "title": "Engine",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "variant": {
          "minLength": 1,
          "title": "Variant",
          "type": "string"
        }
      },
      "required": [
        "engine",
        "variant",
        "start",
        "end",
        "text"
      ],
      "title": "UncertaintySlice",
      "type": "object"
    },
    "UncertaintySpan": {
      "additionalProperties": false,
      "description": "A character-aligned disagreement. It records every reading's slice and picks none of them.",
      "properties": {
        "classes": {
          "items": {
            "enum": [
              "digit",
              "sign",
              "decimal",
              "symbol"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Classes",
          "type": "array"
        },
        "slices": {
          "items": {
            "$ref": "#/$defs/UncertaintySlice"
          },
          "minItems": 2,
          "title": "Slices",
          "type": "array"
        }
      },
      "required": [
        "classes",
        "slices"
      ],
      "title": "UncertaintySpan",
      "type": "object"
    }
  },
  "$id": "urn:llb:artifact-contract:llb.book-ocr-block-ledger:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`pages/<pNNNN>/blocks.json`: the block ledger of one PDF page.",
  "properties": {
    "blocks": {
      "items": {
        "$ref": "#/$defs/Block"
      },
      "title": "Blocks",
      "type": "array"
    },
    "kind": {
      "const": "book-ocr-block-ledger",
      "title": "Kind",
      "type": "string"
    },
    "page_id": {
      "minLength": 1,
      "title": "Page Id",
      "type": "string"
    },
    "pdf_page": {
      "minimum": 1,
      "title": "Pdf Page",
      "type": "integer"
    },
    "schema_id": {
      "const": "llb.book-ocr-block-ledger",
      "title": "Schema Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "kind",
    "page_id",
    "pdf_page"
  ],
  "title": "PageBlockLedger",
  "type": "object"
}
