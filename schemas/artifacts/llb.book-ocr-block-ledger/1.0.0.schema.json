{
  "$defs": {
    "Block": {
      "additionalProperties": false,
      "description": "One recovered region: its kind, where it sits, and every raw reading of it.",
      "properties": {
        "block_id": {
          "minLength": 1,
          "title": "Block Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "body",
            "heading",
            "formula",
            "table",
            "figure",
            "caption",
            "footnote",
            "running-header",
            "page-number",
            "ornament",
            "neighbour-page-bleed",
            "unknown"
          ],
          "title": "Kind",
          "type": "string"
        },
        "ordinal": {
          "minimum": 0,
          "title": "Ordinal",
          "type": "integer"
        },
        "paragraph": {
          "default": false,
          "title": "Paragraph",
          "type": "boolean"
        },
        "pdf_page": {
          "minimum": 1,
          "title": "Pdf Page",
          "type": "integer"
        },
        "reading_order": {
          "minimum": 0,
          "title": "Reading Order",
          "type": "integer"
        },
        "readings": {
          "items": {
            "$ref": "#/$defs/RawReading"
          },
          "minItems": 1,
          "title": "Readings",
          "type": "array"
        },
        "region": {
          "$ref": "#/$defs/Region"
        },
        "uncertainty": {
          "items": {
            "$ref": "#/$defs/UncertaintySpan"
          },
          "title": "Uncertainty",
          "type": "array"
        }
      },
      "required": [
        "block_id",
        "pdf_page",
        "ordinal",
        "kind",
        "region",
        "reading_order",
        "readings"
      ],
      "title": "Block",
      "type": "object"
    },
    "RawReading": {
      "additionalProperties": false,
      "description": "One engine's text for one image variant. Raw: nothing here has been chosen or corrected.",
      "properties": {
        "confidence": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "engine": {
          "minLength": 1,
          "title": "Engine",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "variant": {
          "minLength": 1,
          "title": "Variant",
          "type": "string"
        }
      },
      "required": [
        "engine",
        "variant",
        "text"
      ],
      "title": "RawReading",
      "type": "object"
    },
    "Region": {
      "additionalProperties": false,
      "description": "An axis-aligned box on the rendered page image, origin at the top left, in pixels.",
      "properties": {
        "height": {
          "minimum": 1,
          "title": "Height",
          "type": "integer"
        },
        "width": {
          "minimum": 1,
          "title": "Width",
          "type": "integer"
        },
        "x0": {
          "minimum": 0,
          "title": "X0",
          "type": "number"
        },
        "x1": {
          "title": "X1",
          "type": "number"
        },
        "y0": {
          "minimum": 0,
          "title": "Y0",
          "type": "number"
        },
        "y1": {
          "title": "Y1",
          "type": "number"
        }
      },
      "required": [
        "x0",
        "y0",
        "x1",
        "y1",
        "width",
        "height"
      ],
      "title": "Region",
      "type": "object"
    },
    "UncertaintySlice": {
      "additionalProperties": false,
      "description": "The characters one reading has across a disagreement, as offsets into that reading.",
      "properties": {
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "integer"
        },
        "engine": {
          "minLength": 1,
          "title": "Engine",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "variant": {
          "minLength": 1,
          "title": "Variant",
          "type": "string"
        }
      },
      "required": [
        "engine",
        "variant",
        "start",
        "end",
        "text"
      ],
      "title": "UncertaintySlice",
      "type": "object"
    },
    "UncertaintySpan": {
      "additionalProperties": false,
      "description": "A character-aligned disagreement. It records every reading's slice and picks none of them.",
      "properties": {
        "classes": {
          "items": {
            "enum": [
              "digit",
              "sign",
              "decimal",
              "symbol"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Classes",
          "type": "array"
        },
        "slices": {
          "items": {
            "$ref": "#/$defs/UncertaintySlice"
          },
          "minItems": 2,
          "title": "Slices",
          "type": "array"
        }
      },
      "required": [
        "classes",
        "slices"
      ],
      "title": "UncertaintySpan",
      "type": "object"
    }
  },
  "$id": "urn:llb:artifact-contract:llb.book-ocr-block-ledger:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`pages/<pNNNN>/blocks.json`: the block ledger of one PDF page.",
  "properties": {
    "blocks": {
      "items": {
        "$ref": "#/$defs/Block"
      },
      "title": "Blocks",
      "type": "array"
    },
    "kind": {
      "const": "book-ocr-block-ledger",
      "title": "Kind",
      "type": "string"
    },
    "page_id": {
      "minLength": 1,
      "title": "Page Id",
      "type": "string"
    },
    "pdf_page": {
      "minimum": 1,
      "title": "Pdf Page",
      "type": "integer"
    },
    "schema_id": {
      "const": "llb.book-ocr-block-ledger",
      "title": "Schema Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "kind",
    "page_id",
    "pdf_page"
  ],
  "title": "PageBlockLedger",
  "type": "object"
}
