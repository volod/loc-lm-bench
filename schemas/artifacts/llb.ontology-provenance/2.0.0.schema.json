{
  "$defs": {
    "CorpusVersionRecord": {
      "additionalProperties": false,
      "description": "Portable identity of the corpus version a bundle was drafted from.",
      "properties": {
        "acquisition_run_ids": {
          "items": {
            "type": "string"
          },
          "title": "Acquisition Run Ids",
          "type": "array"
        },
        "corpus_fingerprint": {
          "minLength": 1,
          "title": "Corpus Fingerprint",
          "type": "string"
        }
      },
      "required": [
        "corpus_fingerprint"
      ],
      "title": "CorpusVersionRecord",
      "type": "object"
    },
    "ProvenanceDocument": {
      "additionalProperties": false,
      "description": "A current document row: local identity plus the acquisition provenance it carries.",
      "properties": {
        "acquisition_run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Acquisition Run Id"
        },
        "capture_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capture Id"
        },
        "capture_time": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capture Time"
        },
        "doc_id": {
          "minLength": 1,
          "title": "Doc Id",
          "type": "string"
        },
        "licence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Licence"
        },
        "n_chars": {
          "minimum": 0,
          "title": "N Chars",
          "type": "integer"
        },
        "payload_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Payload Digest"
        },
        "revision_of": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revision Of"
        },
        "sha256": {
          "minLength": 1,
          "title": "Sha256",
          "type": "string"
        },
        "source_uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Uri"
        }
      },
      "required": [
        "doc_id",
        "sha256",
        "n_chars"
      ],
      "title": "ProvenanceDocument",
      "type": "object"
    }
  },
  "$id": "urn:llb:artifact-contract:llb.ontology-provenance:2.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The current bundle record: the corpus version it drafted from, stated per document.",
  "properties": {
    "abort": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Abort"
    },
    "applied_feedback": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Applied Feedback"
    },
    "corpus_version": {
      "anyOf": [
        {
          "$ref": "#/$defs/CorpusVersionRecord"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "cost": {
      "additionalProperties": true,
      "title": "Cost",
      "type": "object"
    },
    "dedup": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dedup"
    },
    "documents": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/ProvenanceDocument"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Documents"
    },
    "elapsed_s": {
      "minimum": 0.0,
      "title": "Elapsed S",
      "type": "number"
    },
    "endpoint": {
      "additionalProperties": true,
      "title": "Endpoint",
      "type": "object"
    },
    "kind": {
      "const": "ontology-drafted",
      "title": "Kind",
      "type": "string"
    },
    "labels": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Labels"
    },
    "multi_hop_carry_forward": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Multi Hop Carry Forward"
    },
    "multi_hop_path_strata": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Multi Hop Path Strata"
    },
    "n_items": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "N Items"
    },
    "ontology": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ontology"
    },
    "prompts": {
      "anyOf": [
        {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prompts"
    },
    "schema_id": {
      "const": "llb.ontology-provenance",
      "title": "Schema Id",
      "type": "string"
    },
    "schema_version": {
      "const": "2.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "seed": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Seed"
    },
    "seed_coverage": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Seed Coverage"
    },
    "settings": {
      "additionalProperties": true,
      "title": "Settings",
      "type": "object"
    },
    "stages": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stages"
    },
    "status": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Status"
    },
    "synthetic": {
      "title": "Synthetic",
      "type": "boolean"
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "kind",
    "synthetic",
    "elapsed_s"
  ],
  "title": "OntologyProvenance",
  "type": "object"
}
