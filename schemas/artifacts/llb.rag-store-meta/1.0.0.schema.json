{
  "$defs": {
    "DuplicateCensus": {
      "additionalProperties": false,
      "description": "The duplicate rate of a chunk set at one tier (`llb.rag.duplicates.collapse`).",
      "properties": {
        "collapsed": {
          "minimum": 0,
          "title": "Collapsed",
          "type": "integer"
        },
        "cross_document_groups": {
          "minimum": 0,
          "title": "Cross Document Groups",
          "type": "integer"
        },
        "duplicate_chunks": {
          "minimum": 0,
          "title": "Duplicate Chunks",
          "type": "integer"
        },
        "duplicate_share": {
          "title": "Duplicate Share",
          "type": "number"
        },
        "groups": {
          "minimum": 0,
          "title": "Groups",
          "type": "integer"
        },
        "intra_document_groups": {
          "minimum": 0,
          "title": "Intra Document Groups",
          "type": "integer"
        },
        "largest_group": {
          "minimum": 0,
          "title": "Largest Group",
          "type": "integer"
        },
        "n": {
          "minimum": 0,
          "title": "N",
          "type": "integer"
        },
        "tier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tier"
        },
        "unique": {
          "minimum": 0,
          "title": "Unique",
          "type": "integer"
        }
      },
      "required": [
        "n",
        "unique",
        "collapsed",
        "duplicate_chunks",
        "duplicate_share",
        "groups",
        "largest_group",
        "intra_document_groups",
        "cross_document_groups"
      ],
      "title": "DuplicateCensus",
      "type": "object"
    },
    "LexicalSummary": {
      "additionalProperties": false,
      "description": "What the BM25 side of a hybrid store holds, stated without loading its postings.",
      "properties": {
        "lemmatize": {
          "title": "Lemmatize",
          "type": "boolean"
        },
        "n_terms": {
          "minimum": 0,
          "title": "N Terms",
          "type": "integer"
        }
      },
      "required": [
        "lemmatize",
        "n_terms"
      ],
      "title": "LexicalSummary",
      "type": "object"
    }
  },
  "$id": "urn:llb:artifact-contract:llb.rag-store-meta:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`store_meta.json` as written before a store recorded its opaque index members.\n\nThe duplicate-collapse knobs are optional here for one reason: this single version covers\nevery store this project wrote before the registry existed, and those span the release where\ncollapse shipped. A meta that states them is carried through; one that does not has them\nsupplied by the migration from the same constants its readers were already defaulting to.",
  "properties": {
    "backend": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Backend"
    },
    "child_size": {
      "minimum": 0,
      "title": "Child Size",
      "type": "integer"
    },
    "collapse_duplicates": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Collapse Duplicates"
    },
    "corpus_fingerprint": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Corpus Fingerprint"
    },
    "corpus_manifest": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Corpus Manifest"
    },
    "dim": {
      "minimum": 0,
      "title": "Dim",
      "type": "integer"
    },
    "doc_fingerprints": {
      "anyOf": [
        {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Doc Fingerprints"
    },
    "duplicate_tier": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Duplicate Tier"
    },
    "duplicates": {
      "anyOf": [
        {
          "$ref": "#/$defs/DuplicateCensus"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "embedder_fingerprint": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Embedder Fingerprint"
    },
    "embedding_model": {
      "title": "Embedding Model",
      "type": "string"
    },
    "governance_fields": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Governance Fields"
    },
    "lexical": {
      "anyOf": [
        {
          "$ref": "#/$defs/LexicalSummary"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "mode": {
      "title": "Mode",
      "type": "string"
    },
    "n_indexed": {
      "minimum": 0,
      "title": "N Indexed",
      "type": "integer"
    },
    "n_parents": {
      "minimum": 0,
      "title": "N Parents",
      "type": "integer"
    },
    "overlap": {
      "minimum": 0,
      "title": "Overlap",
      "type": "integer"
    },
    "page_annotation_coverage": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Page Annotation Coverage"
    },
    "refreshed_from": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Refreshed From"
    },
    "schema_id": {
      "const": "llb.rag-store-meta",
      "title": "Schema Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "size": {
      "minimum": 0,
      "title": "Size",
      "type": "integer"
    },
    "strategy": {
      "title": "Strategy",
      "type": "string"
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "mode",
    "strategy",
    "size",
    "overlap",
    "child_size",
    "embedding_model",
    "n_indexed",
    "n_parents",
    "dim"
