{
  "$id": "urn:llb:artifact-contract:llb.run-progress-meta:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The determinism-critical identity a `--resume` is checked against.",
  "properties": {
    "config_digest": {
      "minLength": 1,
      "title": "Config Digest",
      "type": "string"
    },
    "goldset_digest": {
      "minLength": 1,
      "title": "Goldset Digest",
      "type": "string"
    },
    "n_items": {
      "minimum": 0,
      "title": "N Items",
      "type": "integer"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_id": {
      "const": "llb.run-progress-meta",
      "title": "Schema Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "split": {
      "title": "Split",
      "type": "string"
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "run_id",
    "split",
    "config_digest",
    "goldset_digest",
    "n_items"
  ],
  "title": "RunProgressMeta",
  "type": "object"
