{
  "$id": "urn:llb:artifact-contract:llb.run-progress-meta:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`cases.progress.meta.json`: the identity a resume must still match to be the same run.\n\nThe retry budget is deliberately not part of it -- a run may be resumed with a different one\n-- so a mismatch here is always a difference that would change the scored result.",
  "properties": {
    "config_digest": {
      "minLength": 1,
      "title": "Config Digest",
      "type": "string"
    },
    "goldset_digest": {
      "minLength": 1,
      "title": "Goldset Digest",
      "type": "string"
    },
    "n_items": {
      "minimum": 0,
      "title": "N Items",
      "type": "integer"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_id": {
      "const": "llb.run-progress-meta",
      "default": "llb.run-progress-meta",
      "title": "Schema Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "split": {
      "title": "Split",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "split",
    "config_digest",
    "goldset_digest",
    "n_items"
  ],
  "title": "CaseProgressMeta",
  "type": "object"
}
