{
  "$defs": {
    "CorpusItemRecord": {
      "additionalProperties": false,
      "description": "One source document's ingestion outcome, mirroring `llb.prep.corpus.CorpusItem`.\n\nEvery governance field is present on every row, `None` where the corpus carries none, so a\nmanifest states an absence rather than leaving a reader to infer one.",
      "properties": {
        "acl_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Acl Label"
        },
        "acquisition_run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Acquisition Run Id"
        },
        "capture_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capture Id"
        },
        "capture_time": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capture Time"
        },
        "doc_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Doc Id"
        },
        "effective_date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective Date"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "ingestion_time": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ingestion Time"
        },
        "kind": {
          "enum": [
            "pdf",
            "text"
          ],
          "title": "Kind",
          "type": "string"
        },
        "language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Language"
        },
        "licence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Licence"
        },
        "n_chars": {
          "minimum": 0,
          "title": "N Chars",
          "type": "integer"
        },
        "parser": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parser"
        },
        "payload_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Payload Digest"
        },
        "reused": {
          "default": false,
          "title": "Reused",
          "type": "boolean"
        },
        "revision_of": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revision Of"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "source_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Sha256"
        },
        "source_system": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source System"
        },
        "source_uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Uri"
        },
        "status": {
          "enum": [
            "ok",
            "too_short",
            "error"
          ],
          "title": "Status",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "source",
        "doc_id",
        "kind",
        "status",
        "n_chars"
      ],
      "title": "CorpusItemRecord",
      "type": "object"
    }
  },
  "$id": "urn:llb:artifact-contract:llb.corpus-manifest:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`corpus_manifest.json`: every ingested source, its status, and the corpus fingerprint.",
  "properties": {
    "corpus_fingerprint": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Corpus Fingerprint"
    },
    "corpus_root": {
      "minLength": 1,
      "title": "Corpus Root",
      "type": "string"
    },
    "governance_coverage": {
      "additionalProperties": true,
      "title": "Governance Coverage",
      "type": "object"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/CorpusItemRecord"
      },
      "title": "Items",
      "type": "array"
    },
    "kind": {
      "const": "corpus",
      "title": "Kind",
      "type": "string"
    },
    "n_docs": {
      "minimum": 0,
      "title": "N Docs",
      "type": "integer"
    },
    "n_removed_sources": {
      "minimum": 0,
      "title": "N Removed Sources",
      "type": "integer"
    },
    "n_reused": {
      "minimum": 0,
      "title": "N Reused",
      "type": "integer"
    },
    "n_skipped": {
      "minimum": 0,
      "title": "N Skipped",
      "type": "integer"
    },
    "n_sources": {
      "minimum": 0,
      "title": "N Sources",
      "type": "integer"
    },
    "removed_sources": {
      "items": {
        "type": "string"
      },
      "title": "Removed Sources",
      "type": "array"
    },
    "schema_id": {
      "const": "llb.corpus-manifest",
      "title": "Schema Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_root": {
      "minLength": 1,
      "title": "Source Root",
      "type": "string"
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "kind",
    "source_root",
    "corpus_root",
    "n_sources",
    "n_docs",
    "n_skipped",
    "n_reused",
    "n_removed_sources"
  ],
  "title": "CorpusManifest",
  "type": "object"
}
