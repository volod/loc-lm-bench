{
  "$defs": {
    "ChunkRecord": {
      "additionalProperties": false,
      "properties": {
        "char_end": {
          "title": "Char End",
          "type": "integer"
        },
        "char_start": {
          "title": "Char Start",
          "type": "integer"
        },
        "chunk_id": {
          "title": "Chunk Id",
          "type": "string"
        },
        "doc_id": {
          "title": "Doc Id",
          "type": "string"
        },
        "matched_child_id": {
          "title": "Matched Child Id",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "overlap": {
          "title": "Overlap",
          "type": "integer"
        },
        "parent_id": {
          "title": "Parent Id",
          "type": "string"
        },
        "pre_rerank_rank": {
          "title": "Pre Rerank Rank",
          "type": "integer"
        },
        "rank": {
          "title": "Rank",
          "type": "integer"
        },
        "rerank_score": {
          "title": "Rerank Score",
          "type": "number"
        },
        "retrieval_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Retrieval Score"
        },
        "size": {
          "title": "Size",
          "type": "integer"
        },
        "strategy": {
          "title": "Strategy",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "doc_id",
        "char_start",
        "char_end",
        "text"
      ],
      "title": "ChunkRecord",
      "type": "object"
    },
    "JournaledCaseState": {
      "additionalProperties": false,
      "description": "The durable projection of one completed case's graph state.\n\nThis is deliberately NARROWER than the in-memory `RagState`: the question, the gold spans, and\nthe assembled context are inputs a resume rebuilds, while everything here is an OUTPUT that\ncannot be recomputed without calling the model again. Every field is optional because a lane\nthat never ran a step never journals its columns -- but the SET is exhaustive, and\n`llb.executor.durability_journal` trims a state to exactly these keys, so a column added to a\nscore row without being added here is a column a resumed case would silently lose.",
      "properties": {
        "answer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Answer"
        },
        "envelope": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Envelope"
        },
        "envelope_error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Envelope Error"
        },
        "envelope_repaired": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Envelope Repaired"
        },
        "envelope_status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Envelope Status"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "prompt_chunks": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/ChunkRecord"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Chunks"
        },
        "query_corrections": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query Corrections"
        },
        "query_decomposition": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query Decomposition"
        },
        "query_dense": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query Dense"
        },
        "query_hypothetical_answer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query Hypothetical Answer"
        },
        "query_processed": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query Processed"
        },
        "query_subqueries": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query Subqueries"
        },
        "rerank_latency_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rerank Latency S"
        },
        "retrieve_latency_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrieve Latency S"
        },
        "retrieved": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/ChunkRecord"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrieved"
        },
        "status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status"
        },
        "table_header_chars": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Table Header Chars"
        },
        "table_headers_restored": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Table Headers Restored"
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/UsageRecord"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "validation_axioms": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Validation Axioms"
        },
        "validation_checked_triples": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Validation Checked Triples"
        },
        "validation_classes": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Validation Classes"
        },
        "validation_error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Validation Error"
        },
        "validation_repaired": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Validation Repaired"
        },
        "validation_violations": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Validation Violations"
        }
      },
      "title": "JournaledCaseState",
      "type": "object"
    },
    "UsageRecord": {
      "additionalProperties": false,
      "properties": {
        "completion_tokens": {
          "title": "Completion Tokens",
          "type": "integer"
        },
        "latency_s": {
          "title": "Latency S",
          "type": "number"
        },
        "prompt_tokens": {
          "title": "Prompt Tokens",
          "type": "integer"
        },
        "tokens_per_s": {
          "title": "Tokens Per S",
          "type": "number"
        }
      },
      "title": "UsageRecord",
      "type": "object"
    }
  },
  "$id": "urn:llb:artifact-contract:llb.run-progress:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One completed case in the append-only resume journal (`cases.progress.jsonl`).",
  "properties": {
    "item_id": {
      "minLength": 1,
      "title": "Item Id",
      "type": "string"
    },
    "schema_id": {
      "const": "llb.run-progress",
      "default": "llb.run-progress",
      "title": "Schema Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/JournaledCaseState"
    }
  },
  "required": [
    "item_id",
    "state"
  ],
  "title": "CaseProgressRow",
  "type": "object"
}
