{
  "$defs": {
    "BootstrapRatioRow": {
      "additionalProperties": false,
      "description": "A count ratio whose lower-bound reading is qualified from the same bootstrap draw.",
      "properties": {
        "hi": {
          "title": "Hi",
          "type": "number"
        },
        "lo": {
          "title": "Lo",
          "type": "number"
        },
        "mean": {
          "title": "Mean",
          "type": "number"
        },
        "stability": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReadingStabilityRow"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "mean",
        "lo",
        "hi"
      ],
      "title": "BootstrapRatioRow",
      "type": "object"
    },
    "IntervalRow": {
      "additionalProperties": false,
      "description": "A point estimate with its percentile-bootstrap confidence bounds.",
      "properties": {
        "hi": {
          "title": "Hi",
          "type": "number"
        },
        "lo": {
          "title": "Lo",
          "type": "number"
        },
        "mean": {
          "title": "Mean",
          "type": "number"
        }
      },
      "required": [
        "mean",
        "lo",
        "hi"
      ],
      "title": "IntervalRow",
      "type": "object"
    },
    "PairedComparisonRow": {
      "additionalProperties": false,
      "description": "A candidate-minus-baseline delta plus the item-level win/loss/tie ledger.",
      "properties": {
        "delta": {
          "$ref": "#/$defs/IntervalRow"
        },
        "losses": {
          "minimum": 0,
          "title": "Losses",
          "type": "integer"
        },
        "randomization_method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Randomization Method"
        },
        "randomization_p": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Randomization P"
        },
        "randomization_samples": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Randomization Samples"
        },
        "sign_test_p": {
          "title": "Sign Test P",
          "type": "number"
        },
        "stability": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReadingStabilityRow"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "ties": {
          "minimum": 0,
          "title": "Ties",
          "type": "integer"
        },
        "wins": {
          "minimum": 0,
          "title": "Wins",
          "type": "integer"
        }
      },
      "required": [
        "delta",
        "wins",
        "losses",
        "ties",
        "sign_test_p"
      ],
      "title": "PairedComparisonRow",
      "type": "object"
    },
    "PolicyResultRow": {
      "additionalProperties": false,
      "description": "One policy's whole reading on one split.",
      "properties": {
        "graph_questions": {
          "minimum": 0,
          "title": "Graph Questions",
          "type": "integer"
        },
        "multi_span_coverage": {
          "$ref": "#/$defs/PairedComparisonRow"
        },
        "multi_span_n": {
          "minimum": 0,
          "title": "Multi Span N",
          "type": "integer"
        },
        "n": {
          "minimum": 0,
          "title": "N",
          "type": "integer"
        },
        "policy": {
          "$ref": "#/$defs/PolicySpecRow"
        },
        "recommendation_gate": {
          "title": "Recommendation Gate",
          "type": "boolean"
        },
        "route": {
          "$ref": "#/$defs/RouteQualityRow"
        },
        "route_errors": {
          "items": {
            "$ref": "#/$defs/RouteErrorRow"
          },
          "title": "Route Errors",
          "type": "array"
        },
        "single_span_n": {
          "minimum": 0,
          "title": "Single Span N",
          "type": "integer"
        },
        "single_span_recall": {
          "$ref": "#/$defs/PairedComparisonRow"
        },
        "vector_questions": {
          "minimum": 0,
          "title": "Vector Questions",
          "type": "integer"
        }
      },
      "required": [
        "policy",
        "n",
        "multi_span_n",
        "single_span_n",
        "graph_questions",
        "vector_questions",
        "route",
        "multi_span_coverage",
        "single_span_recall",
        "recommendation_gate"
      ],
      "title": "PolicyResultRow",
      "type": "object"
    },
    "PolicySpecRow": {
      "additionalProperties": false,
      "description": "The thresholds one routing policy is defined by.",
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "long_question_words": {
          "minimum": 0,
          "title": "Long Question Words",
          "type": "integer"
        },
        "min_linked_entities": {
          "minimum": 0,
          "title": "Min Linked Entities",
          "type": "integer"
        }
      },
      "required": [
        "label",
        "long_question_words",
        "min_linked_entities"
      ],
      "title": "PolicySpecRow",
      "type": "object"
    },
    "ReadingStabilityRow": {
      "additionalProperties": false,
      "description": "One row's reading plus how close it sits to the cut that produced it.\n\n`looser_reading` / `tighter_reading` are what the neighbouring confidence conventions read, so\na `borderline` row is one whose reading is the convention's rather than the data's; `side`\nsays which way. `discordant` and `pairs` are absent on an artifact recorded before the\nevidence gate existed.",
      "properties": {
        "borderline": {
          "title": "Borderline",
          "type": "boolean"
        },
        "discordant": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Discordant"
        },
        "looser_reading": {
          "title": "Looser Reading",
          "type": "string"
        },
        "p_positive": {
          "title": "P Positive",
          "type": "number"
        },
        "pairs": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pairs"
        },
        "randomization_method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Randomization Method"
        },
        "randomization_p": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Randomization P"
        },
        "randomization_samples": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Randomization Samples"
        },
        "reading": {
          "title": "Reading",
          "type": "string"
        },
        "side": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Side"
        },
        "tighter_reading": {
          "title": "Tighter Reading",
          "type": "string"
        }
      },
      "required": [
        "reading",
        "p_positive",
        "looser_reading",
        "tighter_reading",
        "borderline"
      ],
      "title": "ReadingStabilityRow",
      "type": "object"
    },
    "RouteErrorRow": {
      "additionalProperties": false,
      "description": "One misrouted item, with the signals the policy decided it on.",
      "properties": {
        "expected": {
          "title": "Expected",
          "type": "string"
        },
        "item_id": {
          "title": "Item Id",
          "type": "string"
        },
        "predicted": {
          "title": "Predicted",
          "type": "string"
        },
        "signals": {
          "items": {
            "type": "string"
          },
          "title": "Signals",
          "type": "array"
        }
      },
      "required": [
        "item_id",
        "predicted",
        "expected"
      ],
      "title": "RouteErrorRow",
      "type": "object"
    },
    "RouteQualityRow": {
      "additionalProperties": false,
      "description": "How often a policy routed to the graph lane when it should have, and vice versa.",
      "properties": {
        "false_negative": {
          "minimum": 0,
          "title": "False Negative",
          "type": "integer"
        },
        "false_positive": {
          "minimum": 0,
          "title": "False Positive",
          "type": "integer"
        },
        "precision": {
          "$ref": "#/$defs/BootstrapRatioRow"
        },
        "recall": {
          "$ref": "#/$defs/BootstrapRatioRow"
        },
        "true_negative": {
          "minimum": 0,
          "title": "True Negative",
          "type": "integer"
        },
        "true_positive": {
          "minimum": 0,
          "title": "True Positive",
          "type": "integer"
        }
      },
      "required": [
        "true_positive",
        "false_positive",
        "true_negative",
        "false_negative",
        "precision",
        "recall"
      ],
      "title": "RouteQualityRow",
      "type": "object"
    }
  },
  "$id": "urn:llb:artifact-contract:llb.fusion-routing-calibration:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The `calibrate-fusion-routing` sidecar: every tuned policy, the frozen one, the decision.\n\nThe tuning/final split is what the record exists to preserve: `tuning` holds every policy that\nwas searched, `frozen_policy` names the one chosen from it, and `final` is that policy alone\nscored on held-out items. A reader that cannot tell those apart cannot tell a calibrated\nresult from a searched one.",
  "properties": {
    "candidates": {
      "minimum": 0,
      "title": "Candidates",
      "type": "integer"
    },
    "confidence": {
      "title": "Confidence",
      "type": "number"
    },
    "decision": {
      "title": "Decision",
      "type": "string"
    },
    "final": {
      "$ref": "#/$defs/PolicyResultRow"
    },
    "final_split": {
      "title": "Final Split",
      "type": "string"
    },
    "frozen_policy": {
      "title": "Frozen Policy",
      "type": "string"
    },
    "graph_strategy": {
      "title": "Graph Strategy",
      "type": "string"
    },
    "graph_weight": {
      "title": "Graph Weight",
      "type": "number"
    },
    "k": {
      "minimum": 0,
      "title": "K",
      "type": "integer"
    },
    "reason": {
      "title": "Reason",
      "type": "string"
    },
    "recommended_policy": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Recommended Policy"
    },
    "resamples": {
      "minimum": 0,
      "title": "Resamples",
      "type": "integer"
    },
    "schema_id": {
      "const": "llb.fusion-routing-calibration",
      "title": "Schema Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "seed": {
      "title": "Seed",
      "type": "integer"
    },
    "selection_metric": {
      "title": "Selection Metric",
      "type": "string"
    },
    "sidecar_hidden": {
      "title": "Sidecar Hidden",
      "type": "boolean"
    },
    "span_identity": {
      "title": "Span Identity",
      "type": "string"
    },
    "tuning": {
      "additionalProperties": {
        "$ref": "#/$defs/PolicyResultRow"
      },
      "title": "Tuning",
      "type": "object"
    },
    "tuning_split": {
      "title": "Tuning Split",
      "type": "string"
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "k",
    "graph_strategy",
    "graph_weight",
    "candidates",
    "span_identity",
    "tuning_split",
    "final_split",
    "resamples",
    "confidence",
    "seed",
    "sidecar_hidden",
    "selection_metric",
    "frozen_policy",
    "final",
    "decision",
    "reason"
  ],
  "title": "RoutingCalibrationReport",
  "type": "object"
}
