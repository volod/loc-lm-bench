{
  "$defs": {
    "SourceSpanRecord": {
      "additionalProperties": false,
      "description": "A labelled span: char offsets into a source document plus the exact text.",
      "properties": {
        "char_end": {
          "minimum": 0,
          "title": "Char End",
          "type": "integer"
        },
        "char_start": {
          "minimum": 0,
          "title": "Char Start",
          "type": "integer"
        },
        "doc_id": {
          "minLength": 1,
          "title": "Doc Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "doc_id",
        "char_start",
        "char_end",
        "text"
      ],
      "title": "SourceSpanRecord",
      "type": "object"
    }
  },
  "$id": "urn:llb:artifact-contract:llb.needle-item:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One `needle_items.jsonl` row: a gold row plus the review labels it is filtered on.\n\nThe labels live here rather than on the gold row because they are drafting metadata, not part\nof what an answer is scored against; `retrieval_rank` is present only where the drafting run\nwas given an index, and `None` there means \"searched and not found\", never \"not searched\".",
  "properties": {
    "difficulty": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Difficulty"
    },
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "lang": {
      "minLength": 1,
      "title": "Lang",
      "type": "string"
    },
    "provenance": {
      "enum": [
        "sample-generated",
        "public-reused",
        "human-authored",
        "frontier-drafted",
        "ontology-drafted",
        "human-verified"
      ],
      "title": "Provenance",
      "type": "string"
    },
    "question": {
      "minLength": 1,
      "title": "Question",
      "type": "string"
    },
    "question_type": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Question Type"
    },
    "reference_answer": {
      "title": "Reference Answer",
      "type": "string"
    },
    "retrieval_k": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Retrieval K"
    },
    "retrieval_rank": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Retrieval Rank"
    },
    "schema_id": {
      "const": "llb.needle-item",
      "title": "Schema Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_doc_id": {
      "minLength": 1,
      "title": "Source Doc Id",
      "type": "string"
    },
    "source_spans": {
      "items": {
        "$ref": "#/$defs/SourceSpanRecord"
      },
      "minItems": 1,
      "title": "Source Spans",
      "type": "array"
    },
    "split": {
      "enum": [
        "calibration",
        "tuning",
        "final"
      ],
      "title": "Split",
      "type": "string"
    },
    "verified": {
      "title": "Verified",
      "type": "boolean"
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "id",
    "lang",
    "question",
    "reference_answer",
    "source_doc_id",
    "source_spans",
    "provenance",
    "verified",
    "split"
  ],
  "title": "NeedleItemRecord",
  "type": "object"
}
