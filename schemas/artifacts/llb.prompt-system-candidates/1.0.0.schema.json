{
  "$defs": {
    "DroppedContextRow": {
      "additionalProperties": false,
      "description": "The budget the candidate was fitted to and everything it could not carry.",
      "properties": {
        "budget_tokens": {
          "minimum": 0,
          "title": "Budget Tokens",
          "type": "integer"
        },
        "sections": {
          "items": {
            "$ref": "#/$defs/DroppedSectionRow"
          },
          "title": "Sections",
          "type": "array"
        },
        "used_tokens": {
          "minimum": 0,
          "title": "Used Tokens",
          "type": "integer"
        }
      },
      "required": [
        "budget_tokens",
        "used_tokens"
      ],
      "title": "DroppedContextRow",
      "type": "object"
    },
    "DroppedSectionRow": {
      "additionalProperties": false,
      "description": "What one attached-context section lost when it was fitted to the budget.",
      "properties": {
        "dropped_ids": {
          "items": {
            "type": "string"
          },
          "title": "Dropped Ids",
          "type": "array"
        },
        "dropped_tokens": {
          "minimum": 0,
          "title": "Dropped Tokens",
          "type": "integer"
        },
        "n_dropped": {
          "minimum": 0,
          "title": "N Dropped",
          "type": "integer"
        },
        "n_kept": {
          "minimum": 0,
          "title": "N Kept",
          "type": "integer"
        },
        "section": {
          "title": "Section",
          "type": "string"
        }
      },
      "required": [
        "section",
        "n_kept",
        "n_dropped",
        "dropped_tokens"
      ],
      "title": "DroppedSectionRow",
      "type": "object"
    },
    "KnowledgeTreeRow": {
      "additionalProperties": false,
      "description": "The knowledge-tree block a candidate carried, and where its lines came from.\n\n`budget_tokens` is what the render was actually given -- the requested budget capped by the\nprompt budget -- so `requested_budget_tokens` states the ask beside it. Every tree candidate\nalso names the no-tree control it varies (`baseline_prompt_system_id`), which is what makes it\nreadable as a comparison rather than as a lone candidate.",
      "properties": {
        "baseline_prompt_system_id": {
          "title": "Baseline Prompt System Id",
          "type": "string"
        },
        "budget_tokens": {
          "minimum": 0,
          "title": "Budget Tokens",
          "type": "integer"
        },
        "depth": {
          "minimum": 0,
          "title": "Depth",
          "type": "integer"
        },
        "dropped_lines": {
          "minimum": 0,
          "title": "Dropped Lines",
          "type": "integer"
        },
        "kept_lines": {
          "minimum": 0,
          "title": "Kept Lines",
          "type": "integer"
        },
        "requested_budget_tokens": {
          "minimum": 0,
          "title": "Requested Budget Tokens",
          "type": "integer"
        },
        "source_digest": {
          "title": "Source Digest",
          "type": "string"
        },
        "source_kind": {
          "title": "Source Kind",
          "type": "string"
        },
        "used_tokens": {
          "minimum": 0,
          "title": "Used Tokens",
          "type": "integer"
        }
      },
      "required": [
        "depth",
        "budget_tokens",
        "used_tokens",
        "kept_lines",
        "dropped_lines",
        "source_kind",
        "source_digest",
        "requested_budget_tokens",
        "baseline_prompt_system_id"
      ],
      "title": "KnowledgeTreeRow",
      "type": "object"
    },
    "PromptCandidateRow": {
      "additionalProperties": false,
      "description": "One reviewable candidate: its rendered prompts, its budget accounting, its status.",
      "properties": {
        "additional_prompt": {
          "title": "Additional Prompt",
          "type": "string"
        },
        "dropped_context": {
          "$ref": "#/$defs/DroppedContextRow"
        },
        "fields": {
          "$ref": "#/$defs/TemplateFieldsRow"
        },
        "knowledge_tree": {
          "anyOf": [
            {
              "$ref": "#/$defs/KnowledgeTreeRow"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        },
        "prompt_system_id": {
          "title": "Prompt System Id",
          "type": "string"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "system_prompt": {
          "title": "System Prompt",
          "type": "string"
        },
        "used_tokens": {
          "minimum": 0,
          "title": "Used Tokens",
          "type": "integer"
        }
      },
      "required": [
        "prompt_system_id",
        "fields",
        "system_prompt",
        "additional_prompt",
        "dropped_context",
        "used_tokens",
        "status"
      ],
      "title": "PromptCandidateRow",
      "type": "object"
    },
    "TemplateFieldsRow": {
      "additionalProperties": false,
      "description": "The operator-editable knobs one candidate was rendered from.",
      "properties": {
        "anthology_size": {
          "minimum": 0,
          "title": "Anthology Size",
          "type": "integer"
        },
        "graph_reference_style": {
          "title": "Graph Reference Style",
          "type": "string"
        },
        "instruction": {
          "title": "Instruction",
          "type": "string"
        },
        "knowledge_tree_budget": {
          "default": 0,
          "minimum": 0,
          "title": "Knowledge Tree Budget",
          "type": "integer"
        },
        "knowledge_tree_depth": {
          "default": 0,
          "minimum": 0,
          "title": "Knowledge Tree Depth",
          "type": "integer"
        },
        "metadata_density": {
          "title": "Metadata Density",
          "type": "string"
        },
        "role": {
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "role",
        "instruction",
        "metadata_density",
        "graph_reference_style",
        "anthology_size"
      ],
      "title": "TemplateFieldsRow",
      "type": "object"
    }
  },
  "$id": "urn:llb:artifact-contract:llb.prompt-system-candidates:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`candidates.json`: every generated candidate and the review status it carries.",
  "properties": {
    "candidates": {
      "items": {
        "$ref": "#/$defs/PromptCandidateRow"
      },
      "title": "Candidates",
      "type": "array"
    },
    "schema_id": {
      "const": "llb.prompt-system-candidates",
      "title": "Schema Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_id",
    "schema_version"
  ],
  "title": "PromptCandidatesDocument",
  "type": "object"
}
