{
  "$id": "urn:llb:artifact-contract:llb.context-probe:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One row of `probes.jsonl`: how one case answered with its gold context withheld.",
  "properties": {
    "abstained": {
      "title": "Abstained",
      "type": "boolean"
    },
    "answer_preview": {
      "default": "",
      "title": "Answer Preview",
      "type": "string"
    },
    "item_id": {
      "minLength": 1,
      "title": "Item Id",
      "type": "string"
    },
    "n_context": {
      "minimum": 0,
      "title": "N Context",
      "type": "integer"
    },
    "probe": {
      "default": true,
      "title": "Probe",
      "type": "boolean"
    },
    "schema_id": {
      "const": "llb.context-probe",
      "title": "Schema Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "item_id",
    "n_context",
    "status",
    "abstained"
  ],
  "title": "ContextProbeRecord",
  "type": "object"
}
