{
  "$defs": {
    "RetrievedOccurrenceRecord": {
      "additionalProperties": false,
      "description": "One other place a collapsed chunk's text appears (`llb.rag.duplicates.collapse`).",
      "properties": {
        "char_end": {
          "minimum": 0,
          "title": "Char End",
          "type": "integer"
        },
        "char_start": {
          "minimum": 0,
          "title": "Char Start",
          "type": "integer"
        },
        "chunk_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chunk Id"
        },
        "doc_id": {
          "minLength": 1,
          "title": "Doc Id",
          "type": "string"
        }
      },
      "required": [
        "doc_id",
        "char_start",
        "char_end"
      ],
      "title": "RetrievedOccurrenceRecord",
      "type": "object"
    },
    "RetrievedSpanRecord": {
      "additionalProperties": false,
      "description": "One retrieved span as miss analysis reads it back: where it came from and at what rank.\n\n`duplicate_count` and `duplicate_occurrences` are present only for a chunk that collapsed\nbyte-identical copies, so their absence says the chunk collapsed nothing.",
      "properties": {
        "char_end": {
          "minimum": 0,
          "title": "Char End",
          "type": "integer"
        },
        "char_start": {
          "minimum": 0,
          "title": "Char Start",
          "type": "integer"
        },
        "doc_id": {
          "minLength": 1,
          "title": "Doc Id",
          "type": "string"
        },
        "duplicate_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duplicate Count"
        },
        "duplicate_occurrences": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/RetrievedOccurrenceRecord"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duplicate Occurrences"
        },
        "rank": {
          "minimum": 0,
          "title": "Rank",
          "type": "integer"
        },
        "retrieval_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrieval Score"
        },
        "text_preview": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text Preview"
        }
      },
      "required": [
        "doc_id",
        "char_start",
        "char_end",
        "rank"
      ],
      "title": "RetrievedSpanRecord",
      "type": "object"
    },
    "SourceSpanRecord": {
      "additionalProperties": false,
      "description": "One gold span of the item a case was scored against.",
      "properties": {
        "char_end": {
          "minimum": 0,
          "title": "Char End",
          "type": "integer"
        },
        "char_start": {
          "minimum": 0,
          "title": "Char Start",
          "type": "integer"
        },
        "doc_id": {
          "minLength": 1,
          "title": "Doc Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "doc_id",
        "char_start",
        "char_end",
        "text"
      ],
      "title": "SourceSpanRecord",
      "type": "object"
    }
  },
  "$id": "urn:llb:artifact-contract:llb.case-retrieval:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One row of `retrieval.jsonl`: what a case's context held against what it needed.",
  "properties": {
    "gold_spans": {
      "items": {
        "$ref": "#/$defs/SourceSpanRecord"
      },
      "title": "Gold Spans",
      "type": "array"
    },
    "item_id": {
      "minLength": 1,
      "title": "Item Id",
      "type": "string"
    },
    "retrieved": {
      "items": {
        "$ref": "#/$defs/RetrievedSpanRecord"
      },
      "title": "Retrieved",
      "type": "array"
    },
    "schema_id": {
      "const": "llb.case-retrieval",
      "title": "Schema Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "item_id"
  ],
  "title": "CaseRetrievalRecord",
  "type": "object"
}
