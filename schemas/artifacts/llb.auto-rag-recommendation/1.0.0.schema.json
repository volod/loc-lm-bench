{
  "$id": "urn:llb:artifact-contract:llb.auto-rag-recommendation:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`rag_recommendation.yaml`: the configuration an auto-RAG run recommends, and its evidence.\n\nThis is the one artifact of the pipeline an operator copies into a serving config by hand, so\nits top level is named field by field. The five blocks under it stay open: each is the knob set\nof a component that evolves on its own schedule, and `evidence` is a map of stage results whose\nshape each stage owns.",
  "properties": {
    "backend": {
      "minLength": 1,
      "title": "Backend",
      "type": "string"
    },
    "chunking": {
      "additionalProperties": true,
      "title": "Chunking",
      "type": "object"
    },
    "evidence": {
      "additionalProperties": true,
      "title": "Evidence",
      "type": "object"
    },
    "model": {
      "minLength": 1,
      "title": "Model",
      "type": "string"
    },
    "model_name": {
      "minLength": 1,
      "title": "Model Name",
      "type": "string"
    },
    "prompt_system": {
      "additionalProperties": true,
      "title": "Prompt System",
      "type": "object"
    },
    "retrieval": {
      "additionalProperties": true,
      "title": "Retrieval",
      "type": "object"
    },
    "schema_id": {
      "const": "llb.auto-rag-recommendation",
      "title": "Schema Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "serving": {
      "additionalProperties": true,
      "title": "Serving",
      "type": "object"
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "model",
    "model_name",
    "backend"
  ],
  "title": "AutoRagRecommendation",
  "type": "object"
}
