{
  "$defs": {
    "PageInventoryRecord": {
      "additionalProperties": false,
      "description": "What the PDF says about one page before anything renders it.",
      "properties": {
        "embedded_text_chars": {
          "minimum": 0,
          "title": "Embedded Text Chars",
          "type": "integer"
        },
        "height_pt": {
          "exclusiveMinimum": 0,
          "title": "Height Pt",
          "type": "number"
        },
        "image_count": {
          "minimum": 0,
          "title": "Image Count",
          "type": "integer"
        },
        "image_height_px": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image Height Px"
        },
        "image_rotation": {
          "anyOf": [
            {
              "enum": [
                0,
                90,
                180,
                270
              ],
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image Rotation"
        },
        "image_width_px": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image Width Px"
        },
        "native_dpi": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Native Dpi"
        },
        "orientation": {
          "enum": [
            "portrait",
            "landscape"
          ],
          "title": "Orientation",
          "type": "string"
        },
        "rotation": {
          "title": "Rotation",
          "type": "integer"
        },
        "width_pt": {
          "exclusiveMinimum": 0,
          "title": "Width Pt",
          "type": "number"
        }
      },
      "required": [
        "width_pt",
        "height_pt",
        "rotation",
        "orientation",
        "image_count",
        "embedded_text_chars"
      ],
      "title": "PageInventoryRecord",
      "type": "object"
    },
    "PageLedgerRecord": {
      "additionalProperties": false,
      "description": "One page of the run: its identity, its inventory, its page-image digest, its stages.",
      "properties": {
        "batch": {
          "minimum": 0,
          "title": "Batch",
          "type": "integer"
        },
        "image_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image Sha256"
        },
        "inventory": {
          "$ref": "#/$defs/PageInventoryRecord"
        },
        "page_id": {
          "minLength": 1,
          "title": "Page Id",
          "type": "string"
        },
        "pdf_page": {
          "minimum": 1,
          "title": "Pdf Page",
          "type": "integer"
        },
        "stages": {
          "items": {
            "$ref": "#/$defs/PageStageState"
          },
          "title": "Stages",
          "type": "array"
        }
      },
      "required": [
        "page_id",
        "pdf_page",
        "batch",
        "inventory"
      ],
      "title": "PageLedgerRecord",
      "type": "object"
    },
    "PageStageState": {
      "additionalProperties": false,
      "description": "One stage's state on one page, as the ledger projects it.",
      "properties": {
        "attempts": {
          "minimum": 0,
          "title": "Attempts",
          "type": "integer"
        },
        "cache_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cache Key"
        },
        "duration_s": {
          "minimum": 0,
          "title": "Duration S",
          "type": "number"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "reused_from": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reused From"
        },
        "stage": {
          "minLength": 1,
          "title": "Stage",
          "type": "string"
        },
        "status": {
          "enum": [
            "done",
            "failed",
            "blocked",
            "pending"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "stage",
        "status",
        "attempts",
        "duration_s"
      ],
      "title": "PageStageState",
      "type": "object"
    }
  },
  "$id": "urn:llb:artifact-contract:llb.book-ocr-page-manifest:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`metadata/page_manifest.json`: every selected page and the state of every stage on it.",
  "properties": {
    "kind": {
      "const": "book-ocr-page-manifest",
      "title": "Kind",
      "type": "string"
    },
    "n_pages": {
      "minimum": 0,
      "title": "N Pages",
      "type": "integer"
    },
    "pages": {
      "items": {
        "$ref": "#/$defs/PageLedgerRecord"
      },
      "title": "Pages",
      "type": "array"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_id": {
      "const": "llb.book-ocr-page-manifest",
      "title": "Schema Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_page_count": {
      "minimum": 1,
      "title": "Source Page Count",
      "type": "integer"
    },
    "source_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Sha256",
      "type": "string"
    },
    "stage_names": {
      "items": {
        "type": "string"
      },
      "title": "Stage Names",
      "type": "array"
    },
    "summary": {
      "additionalProperties": {
        "additionalProperties": {
          "type": "integer"
        },
        "type": "object"
      },
      "title": "Summary",
      "type": "object"
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "kind",
    "run_id",
    "source_sha256",
    "source_page_count",
    "n_pages"
  ],
  "title": "BookPageManifest",
  "type": "object"
}
