{
  "$defs": {
    "ClaimRecord": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "$ref": "#/$defs/SourceSpanRecord"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "evidence"
      ],
      "title": "ClaimRecord",
      "type": "object"
    },
    "EntityRecord": {
      "additionalProperties": false,
      "properties": {
        "aliases": {
          "items": {
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "mentions": {
          "items": {
            "$ref": "#/$defs/SourceSpanRecord"
          },
          "title": "Mentions",
          "type": "array"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "type": {
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "name",
        "type"
      ],
      "title": "EntityRecord",
      "type": "object"
    },
    "EventRecord": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "title": "Description",
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/SourceSpanRecord"
        }
      },
      "required": [
        "description",
        "evidence"
      ],
      "title": "EventRecord",
      "type": "object"
    },
    "FactRecord": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "$ref": "#/$defs/SourceSpanRecord"
        },
        "object": {
          "title": "Object",
          "type": "string"
        },
        "relation": {
          "title": "Relation",
          "type": "string"
        },
        "subject": {
          "title": "Subject",
          "type": "string"
        }
      },
      "required": [
        "subject",
        "relation",
        "object",
        "evidence"
      ],
      "title": "FactRecord",
      "type": "object"
    },
    "SourceSpanRecord": {
      "additionalProperties": false,
      "description": "A labelled span: char offsets into a source document plus the exact text.",
      "properties": {
        "char_end": {
          "minimum": 0,
          "title": "Char End",
          "type": "integer"
        },
        "char_start": {
          "minimum": 0,
          "title": "Char Start",
          "type": "integer"
        },
        "doc_id": {
          "minLength": 1,
          "title": "Doc Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "doc_id",
        "char_start",
        "char_end",
        "text"
      ],
      "title": "SourceSpanRecord",
      "type": "object"
    }
  },
  "$id": "urn:llb:artifact-contract:llb.ontology-extraction:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One `extraction.jsonl` row: everything extracted from one document, spans exact-grounded.",
  "properties": {
    "claims": {
      "items": {
        "$ref": "#/$defs/ClaimRecord"
      },
      "title": "Claims",
      "type": "array"
    },
    "doc_id": {
      "minLength": 1,
      "title": "Doc Id",
      "type": "string"
    },
    "entities": {
      "items": {
        "$ref": "#/$defs/EntityRecord"
      },
      "title": "Entities",
      "type": "array"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/EventRecord"
      },
      "title": "Events",
      "type": "array"
    },
    "facts": {
      "items": {
        "$ref": "#/$defs/FactRecord"
      },
      "title": "Facts",
      "type": "array"
    },
    "schema_id": {
      "const": "llb.ontology-extraction",
      "title": "Schema Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "doc_id"
  ],
  "title": "OntologyExtractionRow",
  "type": "object"
}
