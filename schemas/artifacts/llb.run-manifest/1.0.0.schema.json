        "backend": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Backend"
        },
        "flashinfer_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Flashinfer Version"
        },
        "gpu_memory_utilization": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Gpu Memory Utilization"
        },
        "gpus": {
          "items": {
            "$ref": "#/$defs/GpuSummary"
          },
          "title": "Gpus",
          "type": "array"
        },
        "load_time_s": {
