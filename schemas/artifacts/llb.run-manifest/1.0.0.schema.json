  "$id": "urn:llb:artifact-contract:llb.run-manifest:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`manifest.json`: the immutable per-run record -- config, environment, headline metrics.\n\nEvery optional block is a lane that may not have run (telemetry, contention, a judge, a\nprompt-system package, a document-lane context window), not a field a reader defaults.",
  "properties": {
    "config": {
      "additionalProperties": true,
      "title": "Config",
      "type": "object"
    },
    "contention": {
      "anyOf": [
        {
          "$ref": "#/$defs/ContentionReport"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "context_window": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Context Window"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "durability": {
      "anyOf": [
        {
          "$ref": "#/$defs/DurabilityStatus"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "env": {
      "$ref": "#/$defs/RunEnvironment"
    },
    "judge": {
      "anyOf": [
        {
          "$ref": "#/$defs/JudgeStatus"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "metrics": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunMetrics"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "n_cases": {
      "default": 0,
      "minimum": 0,
      "title": "N Cases",
      "type": "integer"
    },
    "prompt_system_provenance": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prompt System Provenance"
    },
    "retrieval": {
      "anyOf": [
        {
          "$ref": "#/$defs/RetrievalMetrics"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "run_name": {
      "minLength": 1,
      "title": "Run Name",
      "type": "string"
    },
    "schema_id": {
      "const": "llb.run-manifest",
      "default": "llb.run-manifest",
      "title": "Schema Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "split": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Split"
    },
    "telemetry": {
      "anyOf": [
        {
          "$ref": "#/$defs/TelemetryReport"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "run_id",
    "run_name",
    "config"
  ],
  "title": "RunManifest",
  "type": "object"
}
