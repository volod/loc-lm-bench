{
  "$defs": {
    "ContentionReport": {
      "additionalProperties": false,
      "description": "Pre-launch VRAM-contention guard outcome.",
      "properties": {
        "action": {
          "title": "Action",
          "type": "string"
        },
        "derated": {
          "title": "Derated",
          "type": "boolean"
        },
        "fits": {
          "title": "Fits",
          "type": "boolean"
        },
        "free_mb": {
          "title": "Free Mb",
          "type": "integer"
        },
        "note": {
          "title": "Note",
          "type": "string"
        },
        "requested_util": {
          "title": "Requested Util",
          "type": "number"
        },
        "residents": {
          "items": {
            "$ref": "#/$defs/ResidentProc"
          },
          "title": "Residents",
          "type": "array"
        },
        "safe_util": {
          "title": "Safe Util",
          "type": "number"
        },
        "target_mb": {
          "title": "Target Mb",
          "type": "integer"
        },
        "total_mb": {
          "title": "Total Mb",
          "type": "integer"
        },
        "weight_floor_mb": {
          "title": "Weight Floor Mb",
          "type": "integer"
        }
      },
      "required": [
        "total_mb",
        "free_mb",
        "requested_util",
        "safe_util",
        "target_mb",
        "weight_floor_mb",
        "residents",
        "derated",
        "fits",
        "action",
        "note"
      ],
      "title": "ContentionReport",
      "type": "object"
    },
    "DurabilityStatus": {
