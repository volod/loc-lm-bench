{
  "$id": "urn:llb:artifact-contract:llb.graph-community-summaries:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`community_summaries.json`: community id -> narrative summary.\n\nTagged DIAGNOSTIC everywhere it is produced -- a summary is never returned by `retrieve` and\nnever span-scored -- so the contract records what it is rather than promoting it to evidence.",
  "properties": {
    "role": {
      "const": "diagnostic",
      "default": "diagnostic",
      "title": "Role",
      "type": "string"
    },
    "schema_id": {
      "const": "llb.graph-community-summaries",
      "title": "Schema Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "summaries": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Summaries",
      "type": "object"
    }
  },
  "required": [
    "schema_id",
    "schema_version"
  ],
  "title": "GraphCommunitySummaries",
  "type": "object"
}
